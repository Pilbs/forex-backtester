{
    "name": "forex-backtester-research",
    "main": "src/cloudflare/worker.js",
    "compatibility_date": "2026-09-06",
    "assets": {
        "directory": "./src/web/public",
        "binding": "ASSETS",
        "run_worker_first": ["/api/*"]
    },
    "vars": {
        "CLOUDFLARE_ACCESS_TEAM_DOMAIN": "https://old-field-e3ea.cloudflareaccess.com",
        "CLOUDFLARE_ACCESS_AUD": "7a666baec0b53386702d4cbaab6062f25431c752fc57bce7818ab772983b09ce",
        "APP_VERSION": "research-v1"
    },
    "d1_databases": [
        {
            "binding": "FOREX_DB",
            "database_name": "forex-backtester",
            "database_id": "8bf34fd0-17f4-4bff-a478-2eb81414b4c2",
            "remote": true
        },
        {
            "binding": "RESEARCH_DB",
            "database_name": "forex-research",
            "database_id": "bc6ac6e8-8a8d-450b-9f52-e950194dcda4",
            "migrations_dir": "migrations/research",
            "remote": true
        }
    ],
    "limits": {
        "cpu_ms": 60000,
        "subrequests": 20
    }
}
