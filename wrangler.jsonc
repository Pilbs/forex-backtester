{
    "name": "forex-backtester-research",
    "main": "src/cloudflare/worker.js",
    "compatibility_date": "2026-09-06",
    "assets": {
        "directory": "./src/web/public",
        "binding": "ASSETS",
        "run_worker_first": ["/api/*"]
    },
    "limits": {
        "cpu_ms": 1000,
        "subrequests": 20
    }
}
